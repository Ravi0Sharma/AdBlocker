{
  "name": "adblocker",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "dev": "concurrently -n ts,css -c blue,magenta \"npm:watch:ts\" \"npm:watch:css\"",
    "watch:ts": "tsc --watch --preserveWatchOutput",
    "watch:css": "tailwindcss -i src/styles.css -o extension/css/styles.css --watch",
    "build": "tsc && tailwindcss -i src/styles.css -o extension/css/styles.css --minify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/chrome": "^0.3.7",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
